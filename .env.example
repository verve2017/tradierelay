# Public product URL
APP_ORIGIN=http://localhost:3000

# Generate both values independently with at least 32 random bytes.
TOKEN_PEPPER=replace-with-a-long-random-value
OPERATOR_ACCESS_KEY=replace-with-a-different-long-random-value
CRON_SECRET=replace-with-another-long-random-value

# Dedicated TradieRelay OpenAI project — do not reuse another business's key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Dedicated TradieRelay Twilio account/sub-account and Australian number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Deployed voice worker.
VOICE_WEBSOCKET_URL=wss://tradierelay-voice.example.workers.dev/conversation
VOICE_WEBHOOK_SECRET=replace-with-the-same-secret-as-the-voice-worker

# Optional alternate voice provider callback.
RETELL_WEBHOOK_SECRET=
